<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Bar Pengawas -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#0D47A1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MODE UJIAN AKTIF"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reload"
            android:textSize="11sp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnKeluar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Keluar"
            android:textSize="11sp"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/topBar"
        android:max="100" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressBar" />

    <!-- Overlay Peringatan Pelanggaran -->
    <LinearLayout
        android:id="@+id/warningOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6B71C1C"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERINGATAN KEAMANAN!"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvWarningDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terdeteksi upaya keluar aplikasi atau layar terbelah. Kembalikan ke mode penuh!"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnAcknowledge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KEMBALI KE UJIAN &amp; MATIKAN ALARM"
            android:backgroundTint="#FFFFFF"
            android:textColor="#B71C1C"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
