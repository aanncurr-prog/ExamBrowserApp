<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="Logo SMK Negeri 1 Trucuk"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_smkn1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXAM BROWSER"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0D47A1"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMK NEGERI 1 TRUCUK"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <!-- Header Daftar Mata Uji Otomatis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daftar Ujian Aktif Hari Ini"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#263238" />

                <Button
                    android:id="@+id/btnRefreshJadwal"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="REFRESH"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#455A64"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusJadwal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memuat daftar ujian..."
                android:textSize="12sp"
                android:textColor="#607D8B"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/containerDaftarUjian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp" />

            <!-- Opsi Cadangan: Input Manual & Scan QR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Atau masukkan alamat ujian / scan QR Code"
                android:textSize="13sp"
                android:textColor="#546E7A"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:drawable/edit_text"
                android:hint="https://exam.smkn1trucuk.com"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnMulai"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="MULAI UJIAN"
                android:textStyle="bold"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="SCAN QR CODE UJIAN"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvCopyright"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="copyrights BUDIgital"
        android:textSize="12sp"
        android:textColor="#0D47A1"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="8dp" />

</LinearLayout>
